APP_NAME="LogXense Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bms_vishay
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your-openai-api-key-here

# Editions & module toggles (config/modules.php, docs/09-setup-and-operations.md).
# "full" (default) = every module on. "lite" = machines, machine types, alerts, users/roles and
# the sensor API only (Buildings & Floors, Work Orders, Maintenance and Reports switched off).
# Any one module can still be forced on/off regardless of edition with MODULE_<NAME>=true|false.
APP_EDITION=full
# MODULE_BUILDINGS=true
# MODULE_WORK_ORDERS=true
# MODULE_MAINTENANCE=true
# MODULE_REPORTS=true

# --- Live updates (Laravel Reverb, self-hosted - no third-party service) ---
# Reverb is the WebSocket server (php artisan reverb:start). If it is down the sensor chart
# falls back to polling, so nothing breaks. Replace the three secrets below with your own
# random values on each install (e.g. php -r "echo bin2hex(random_bytes(10));").
REVERB_APP_ID=bms
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
# Where Laravel itself reaches Reverb - same PC, so loopback:
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# What the Reverb process listens on (all network interfaces, so browsers on the LAN can connect):
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Leave blank: the browser connects to the host the page was opened from.
VITE_REVERB_HOST=
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
